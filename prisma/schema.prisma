generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model News {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  publishedAt DateTime @default(now())
  authorId    Int
  type        String   @default("GENERAL")
  author      User     @relation("UserNews", fields: [authorId], references: [id])
}

model User {
  id                        Int                 @id @default(autoincrement())
  email                     String?             @unique
  password                  String?
  name                      String?
  memberType                MemberType          @default(auditeur)
  accessLevel               AccessLevel         @default(member)
  role                      String              @default("user")
  createdAt                 DateTime            @default(now())
  passwordNeedsChange       Boolean             @default(true)
  firstName                 String?
  lastName                  String?
  homePhone                 String?
  cellPhone                 String?
  gestconteNotes            String?
  gestconteId               Int?
  nonProfitAffiliation      String?
  /// LEGACY: replaced by activityStatus + UserActivityEvent. For `db push`: keep
  /// this for the first push, run backfill.sql, THEN delete it and push again.
  isActive                  Boolean?            @default(true)
  activityStatus            UserActivityStatus  @default(ACTIVE)
  activityChangedAt         DateTime?
  /// UNAVAILABLE window, both ends inclusive, stored as UTC-midnight days.
  /// The EFFECTIVE status is computed from these at read time
  /// (lib/users/activityStatus.ts): a window that hasn't started yet, or that
  /// has elapsed, reads as ACTIVE. Nothing rewrites these rows on a schedule.
  unavailableFrom           DateTime?
  unavailableUntil          DateTime?
  /// LEGACY: superseded by UserActivityEvent history; no longer written. Refactor out.
  terminationDate           DateTime?
  /// LEGACY: superseded by UserActivityEvent.reason; no longer written. Refactor out.
  terminationReason         String?
  lastUpdated               DateTime?           @updatedAt
  /// Soft-delete marker. When set, the user is treated as deleted everywhere:
  /// a global Prisma query extension (lib/prisma.ts) excludes rows with a
  /// non-null deletedAt from all user list/search reads.
  deletedAt                 DateTime?
  preferredDeliveryMethod   DeliveryMethod?
  paymentThreshold          Decimal?            @default(21.00) @db.Decimal(10, 2)
  currentBalance            Decimal?            @default(0.00) @db.Decimal(10, 2)
  preferredMediaFormatId    Int?
  preferredMediaFormat      MediaFormat?        @relation("UserPreferredMediaFormat", fields: [preferredMediaFormatId], references: [id])
  isAvailable               Boolean?            @default(true)
  availabilityNotes         String?
  specialization            String?
  saveType                  SaveType?
  maxConcurrentAssignments  Int?                @default(3)
  notes                     String?
  civilityId                Int?
  civilityOther             String?
  addresses                 Address[]
  assignmentsProcessedBy    Assignment[]        @relation("AssignmentsProcessedBy")
  assignmentReaders         AssignmentReader[]
  bills                     Bill[]
  books                     Book[]
  CoupsDeCoeur              CoupsDeCoeur[]
  News                      News[]              @relation("UserNews")
  ordersAsAveugle           Orders[]            @relation("OrdersAsAveugle")
  ordersProcessedBy         Orders[]            @relation("OrdersProcessedBy")
  payments                  Payment[]
  billEventsPerformed       BillEvent[]         @relation("BillEventsPerformedBy")
  orderEventsPerformed      OrderEvent[]        @relation("OrderEventsPerformedBy")
  assignmentEventsPerformed AssignmentEvent[]   @relation("AssignmentEventsPerformedBy")
  bookMergeEventsPerformed  BookMergeEvent[]    @relation("BookMergeEventsPerformedBy")
  activityEvents            UserActivityEvent[] @relation("UserActivityEvents")
  activityEventsPerformed   UserActivityEvent[] @relation("UserActivityEventsBy")
  audioTracksDeleted        DeletedAudioTrack[] @relation("AudioTracksDeletedBy")
  audioTracksRestored       DeletedAudioTrack[] @relation("AudioTracksRestoredBy")
  audioTrackEvents          AudioTrackEvent[]   @relation("AudioTrackEventsPerformedBy")
  languages                 ReaderLanguage[]
  civility                  Civility?           @relation(fields: [civilityId], references: [id])

  @@index([deletedAt])
}

model Address {
  id                Int      @id @default(autoincrement())
  addressLine1      String?
  addressSupplement String?
  city              String?
  postalCode        String?
  stateProvince     String?
  country           String   @default("France")
  isDefault         Boolean  @default(false)
  userId            Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Book {
  id                     Int                 @id @default(autoincrement())
  title                  String
  author                 String
  publishedDate          DateTime?
  isbn                   String?             @unique
  description            String?
  available              Boolean             @default(true)
  /// Excludes the book from the public catalogue and coups de cœur, e.g. for
  /// personal or sensitive titles. Purely a public-visibility flag — the book
  /// stays fully usable in the back office (attributions, demandes, search).
  hiddenFromCatalogue    Boolean             @default(false)
  createdAt              DateTime?           @default(now())
  updatedAt              DateTime            @updatedAt
  addedById              Int
  readingDurationMinutes Int?
  publisher              String?
  pageCount              Int?
  subtitle               String?
  audio_filepath         String?
  stock_date             DateTime?
  last_downloaded_date   DateTime?
  assignments            Assignment[]
  addedBy                User                @relation(fields: [addedById], references: [id])
  genres                 BookGenre[]
  CoupsDeCoeurBooks      CoupsDeCoeurBooks[]
  orders                 Orders[]
  source_access_id       Int?
  needsReview            Boolean             @default(false)
  id_arbre               Int?
  polly_audio_url        String?

  /// State of the link between audio_filepath and the storage bucket, refreshed
  /// by scripts/sync-audio-links.ts. Deliberately NOT `needsReview` — that flag
  /// belongs to the duplicate-fusion queue on /admin/review.
  audioLinkStatus AudioLinkStatus @default(UNVERIFIED)
  audioCheckedAt  DateTime?
  audioTrackCount Int?

  /// Total weight of the book's audio folder, in kibioctets (1 Kio = 1024 o),
  /// refreshed alongside audioTrackCount. Feeds the CD-based tarif in
  /// lib/pricing.ts — a demande costs one CD's worth per 700 Mio started.
  ///
  /// Kio rather than bytes on purpose: a byte count overflows Int past 2 Gio and
  /// would force BigInt, which neither NextResponse.json nor the client-component
  /// boundary can serialize — and a raw Book row crosses both (app/catalogue/data.ts,
  /// app/admin/books/page.tsx, /api/books/[id]). Kio keeps it a plain number up to
  /// 2 Tio, and 1 Kio of precision is nothing next to a 700 Mio block.
  audioSizeKb Int?

  /// Set when a permanent hits "Impossible de fusionner" on /admin/review: the
  /// pair carries two different recordings, so it can only be sorted out by hand
  /// in the database. Stamping the date keeps the escalation mail from being
  /// re-sent on every visit; the book stays in the review queue either way.
  escalatedAt        DateTime?
  orphanAudioFolders OrphanAudioFolder[]
  deletedAudioTracks DeletedAudioTrack[] @relation("BookDeletedAudioTracks")
  audioTrackEvents   AudioTrackEvent[]   @relation("BookAudioTrackEvents")

  @@index([audioLinkStatus])
  @@index([createdAt(sort: Desc)])
  @@index([title])
  @@index([author])
  @@index([isbn])
  @@index([available])
  // Stats dashboard: per-staff-per-day aggregates on /admin/stats.
  @@index([addedById, createdAt])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Genre {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String?
  books       BookGenre[]

  @@index([name])
}

model Civility {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  sortOrder Int?
  isActive  Boolean @default(true)
  users     User[]

  @@index([name])
}

model CoupsDeCoeur {
  id          Int                 @id @default(autoincrement())
  title       String
  description String?
  audioPath   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  active      Boolean             @default(true)
  addedById   Int
  addedBy     User                @relation(fields: [addedById], references: [id])
  books       CoupsDeCoeurBooks[]
}

model CoupsDeCoeurBooks {
  coupsDeCoeurId Int
  bookId         Int
  book           Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  coupsDeCoeur   CoupsDeCoeur @relation(fields: [coupsDeCoeurId], references: [id])

  @@id([coupsDeCoeurId, bookId])
}

model BookGenre {
  bookId  Int
  genreId Int
  book    Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([bookId, genreId])
  @@index([bookId])
  @@index([genreId])
}

model Status {
  id                         Int               @id @default(autoincrement())
  name                       String            @unique
  description                String?
  sortOrder                  Int?
  assignments                Assignment[]
  orders                     Orders[]
  orderEventsFromStatus      OrderEvent[]      @relation("OrderEventsFromStatus")
  orderEventsToStatus        OrderEvent[]      @relation("OrderEventsToStatus")
  assignmentEventsFromStatus AssignmentEvent[] @relation("AssignmentEventsFromStatus")
  assignmentEventsToStatus   AssignmentEvent[] @relation("AssignmentEventsToStatus")

  @@index([name])
}

model MediaFormat {
  id               Int      @id @default(autoincrement())
  name             String   @unique @db.VarChar(80)
  description      String?  @db.VarChar(200)
  orders           Orders[]
  preferredByUsers User[]   @relation("UserPreferredMediaFormat")

  @@index([name])
}

model Bill {
  id               Int           @id @default(autoincrement())
  clientId         Int
  state            BillingStatus @default(BILLED)
  creationDate     DateTime
  issueDate        DateTime?
  paymentDate      DateTime?
  paymentReference String?
  invoiceAmount    Decimal       @db.Decimal(10, 2)
  isActive         Boolean       @default(true)
  deletedAt        DateTime?
  client           User          @relation(fields: [clientId], references: [id])
  orders           Orders[]
  payments         Payment[]
  events           BillEvent[]

  @@index([clientId])
  @@index([state])
  @@index([creationDate])
  @@index([isActive])
}

model Payment {
  id               Int            @id @default(autoincrement())
  clientId         Int?
  type             PaymentType
  amount           Decimal        @db.Decimal(10, 2)
  paymentMethod    PaymentMethod? // modepaiement_id from Access
  creationDate     DateTime
  issueDate        DateTime?
  paymentDate      DateTime?
  exportDate       DateTime?
  importDate       DateTime?
  receiptNumber    String? // num_recu
  fiscalite        String? // source type unclear – tighten to Boolean/enum after inspecting data
  cotisationYear   Int? // Annee_cotisation – only for type COTISATION
  comptable        String? // source type unclear – tighten after inspecting data
  isAllocated      Boolean? // Affectee
  allocationDate   DateTime? // date_affectation
  observations     String?
  billId           Int? // only for type ENREGISTREMENT
  sourceVenteId    Int? // raw idvente preserved for traceability
  sourceEcritureId Int? // raw idecriture (accounting entry) preserved
  isActive         Boolean        @default(true)
  deletedAt        DateTime?
  deletionReason   String? // Obs_Suppression
  client           User?          @relation(fields: [clientId], references: [id])
  bill             Bill?          @relation(fields: [billId], references: [id])

  @@index([clientId])
  @@index([type])
  @@index([billId])
  @@index([creationDate])
  @@index([cotisationYear])
  @@index([isActive])
}

model Orders {
  id                  Int                @id @default(autoincrement())
  aveugleId           Int
  catalogueId         Int
  requestReceivedDate DateTime
  statusId            Int
  isDuplication       Boolean
  mediaFormatId       Int
  deliveryMethod      DeliveryMethod
  processedByStaffId  Int?
  createdDate         DateTime?
  closureDate         DateTime?
  cost                Decimal?           @db.Decimal(10, 2)
  billingStatus       OrderBillingStatus @default(UNBILLED)
  billId              Int?
  lentPhysicalBook    Boolean
  notes               String?
  isActive            Boolean            @default(true)
  deletedAt           DateTime?
  updatedAt           DateTime?
  assignments         Assignment[]
  events              OrderEvent[]
  aveugle             User               @relation("OrdersAsAveugle", fields: [aveugleId], references: [id])
  bill                Bill?              @relation(fields: [billId], references: [id])
  catalogue           Book               @relation(fields: [catalogueId], references: [id])
  mediaFormat         MediaFormat        @relation(fields: [mediaFormatId], references: [id])
  processedByStaff    User?              @relation("OrdersProcessedBy", fields: [processedByStaffId], references: [id])
  status              Status             @relation(fields: [statusId], references: [id])

  @@index([aveugleId])
  @@index([catalogueId])
  @@index([statusId])
  @@index([billingStatus])
  @@index([mediaFormatId])
  @@index([billId])
  @@index([isActive])
  // Stats dashboard: per-staff-per-day aggregates on /admin/stats.
  @@index([processedByStaffId, createdDate])
}

model Assignment {
  id                 Int                @id @default(autoincrement())
  catalogueId        Int
  orderId            Int?
  receptionDate      DateTime?
  sentToReaderDate   DateTime?
  returnedToECADate  DateTime?
  statusId           Int
  notes              String?
  processedByStaffId Int?
  deliveryMethod     DeliveryMethod?
  catalogue          Book               @relation(fields: [catalogueId], references: [id])
  order              Orders?            @relation(fields: [orderId], references: [id])
  processedByStaff   User?              @relation("AssignmentsProcessedBy", fields: [processedByStaffId], references: [id])
  status             Status             @relation(fields: [statusId], references: [id])
  readerHistory      AssignmentReader[]
  events             AssignmentEvent[]

  @@index([catalogueId])
  @@index([orderId])
  @@index([statusId])
  // Attribution windows: /admin/disponibilites (charge des lecteurs, relances).
  @@index([sentToReaderDate])
  @@index([returnedToECADate])
}

model AssignmentReader {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  readerId     Int
  assignedDate DateTime   @default(now())
  notes        String?
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reader       User       @relation(fields: [readerId], references: [id])

  @@index([assignmentId])
  @@index([readerId])
  @@index([assignedDate])
}

enum DeliveryMethod {
  RETRAIT
  ENVOI
  NON_APPLICABLE
}

enum Language {
  /// LEGACY: no longer offered as a specialization (every reader reads French),
  /// but kept here so existing ReaderLanguage rows stay valid and keep rendering.
  /// See LEGACY_LANGUAGE_VALUES in lib/user-enums.ts.
  FRANCAIS
  ANGLAIS
  ESPAGNOL
  ALLEMAND
  ITALIEN
  PORTUGAIS
  ARABE
  RUSSE
  CHINOIS
  GREC_ANCIEN
  GREC_MODERNE
  LATIN
  AUTRE
}

/// A reader's language specialization. One reader → many languages.
model ReaderLanguage {
  id       Int      @id @default(autoincrement())
  userId   Int
  language Language
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, language])
  @@index([userId])
  @@index([language])
}

enum BillingStatus {
  DRAFT
  BILLED
  PAID
  SOLDE
}

enum OrderBillingStatus {
  UNBILLED
  BILLED
  UNBILLABLE
}

enum PaymentType {
  COTISATION
  ENREGISTREMENT
  DON
  DIVERS
}

enum PaymentMethod {
  CHEQUE // Chèque
  ESPECE // Espèce
  CB
  VIREMENT // Virement
  COMPTE_AUXI // Compte Auxi
}

enum MemberType {
  ecouteur // deprecated – remove once all records migrated
  auditeur
  lecteur
  informaticien
  administration
  bienfaiteur
}

enum AccessLevel {
  member
  admin
  super_admin
}

enum SaveType {
  AUDACITY
  GARAGEBAND
  REAPER
  ADOBE_AUDITION
  OCENAUDIO
  WAVEPAD
  LOGIC_PRO
  STUDIO_ONE
  AUTRE
}

enum NewsType {
  GENERAL
  EVENEMENT
  ANNONCE
  ACTUALITE
  PROGRAMMATION
}

model BillEvent {
  id            Int            @id @default(autoincrement())
  billId        Int
  type          BillEventType
  fromState     BillingStatus?
  toState       BillingStatus?
  payload       Json?
  performedById Int?
  createdAt     DateTime       @default(now())
  bill          Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  performedBy   User?          @relation("BillEventsPerformedBy", fields: [performedById], references: [id])

  @@index([billId])
  @@index([createdAt])
  // Stats dashboard: per-staff-per-day aggregates on /admin/stats.
  @@index([performedById, createdAt])
}

enum BillEventType {
  CREATED
  ISSUED
  REOPENED
  PAID
  SETTLED
  AMOUNT_CHANGED
  ORDER_ATTACHED
  ORDER_DETACHED
}

enum OrderEventType {
  CREATED
  CLOSED
  REOPENED
  STATUS_CHANGED
}

/// Append-only history of a demande's processing: creation and every status
/// transition, however it happened — edited directly on the order, or pushed
/// up from its attribution via syncOrderToStatus (see lib/statusSync.ts). That
/// second path is the one the plain Orders columns couldn't represent: closing
/// a demande by finishing its attribution moved no column on Orders itself, so
/// the "Demandes traitées" stat (driven off this table, not Orders directly —
/// see lib/stats.ts) used to miss it entirely.
///
/// Not an audited model (see lib/audit/config.ts): Orders already is, so a
/// status change already gets a generic AuditEvent. This table exists for
/// attribution and for the stats dashboard, not as a second audit trail — like
/// BillEvent and UserActivityEvent, it is its own permanent history and is not
/// subject to the AuditEvent retention purge.
model OrderEvent {
  id            Int            @id @default(autoincrement())
  orderId       Int
  type          OrderEventType
  fromStatusId  Int?
  toStatusId    Int?
  performedById Int?
  createdAt     DateTime       @default(now())
  order         Orders         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus    Status?        @relation("OrderEventsFromStatus", fields: [fromStatusId], references: [id])
  toStatus      Status?        @relation("OrderEventsToStatus", fields: [toStatusId], references: [id])
  performedBy   User?          @relation("OrderEventsPerformedBy", fields: [performedById], references: [id])

  @@index([orderId])
  @@index([createdAt])
  // Stats dashboard: per-staff-per-day aggregates on /admin/stats.
  @@index([performedById, createdAt])
}

enum AssignmentEventType {
  CREATED
  CLOSED
  REOPENED
  STATUS_CHANGED
}

/// Append-only history of an attribution's processing — same rationale as
/// OrderEvent above, mirrored for the assignment side: creation and every
/// status transition, however it happened (direct edit, or pushed down from
/// the demande via syncAssignmentToStatus in lib/statusSync.ts). Not audited
/// (Assignment already is); not subject to the AuditEvent retention purge.
model AssignmentEvent {
  id            Int                 @id @default(autoincrement())
  assignmentId  Int
  type          AssignmentEventType
  fromStatusId  Int?
  toStatusId    Int?
  performedById Int?
  createdAt     DateTime            @default(now())
  assignment    Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fromStatus    Status?             @relation("AssignmentEventsFromStatus", fields: [fromStatusId], references: [id])
  toStatus      Status?             @relation("AssignmentEventsToStatus", fields: [toStatusId], references: [id])
  performedBy   User?               @relation("AssignmentEventsPerformedBy", fields: [performedById], references: [id])

  @@index([assignmentId])
  @@index([createdAt])
  // Stats dashboard: per-staff-per-day aggregates on /admin/stats.
  @@index([performedById, createdAt])
}

/// Four statuses are offered, for every member type: ACTIVE, UNAVAILABLE,
/// RADIATION, DECEASED (see lib/user-activity-enums.ts). INACTIVE is LEGACY:
/// rows recorded under it keep rendering, but it is never offered for a new
/// change. Its value is kept — dropping it would orphan existing User rows and
/// UserActivityEvent history.
///
/// DEMISSION, ON_VACATION, SUSPENDED and PB_SANTE_MENTALE were removed from the
/// enum once their rows were migrated (DEMISSION -> RADIATION, the other three
/// -> INACTIVE). Don't reintroduce them.
enum UserActivityStatus {
  ACTIVE
  UNAVAILABLE
  DECEASED
  RADIATION
  /// LEGACY: no longer offered.
  INACTIVE
}

/// Append-only history of a member's activity-status changes (who/what/when/why).
model UserActivityEvent {
  id               Int                 @id @default(autoincrement())
  userId           Int
  fromStatus       UserActivityStatus?
  toStatus         UserActivityStatus
  reason           String?
  comment          String?
  /// Window recorded with the change when toStatus is UNAVAILABLE, so the
  /// history keeps showing the dates that were set even after they change.
  unavailableFrom  DateTime?
  unavailableUntil DateTime?
  changedById      Int?
  changedAt        DateTime            @default(now())
  user             User                @relation("UserActivityEvents", fields: [userId], references: [id])
  changedBy        User?               @relation("UserActivityEventsBy", fields: [changedById], references: [id])

  @@index([userId])
  @@index([changedAt])
}

/// Append-only audit log of book duplicate fusions. One row per FUSE action,
/// keeping a JSON snapshot of the removed duplicate. Never updated or deleted.
/// canonicalId / duplicateId are plain ints (no FK) so the row survives the
/// duplicate's deletion — and any later deletion of the canonical.
model BookMergeEvent {
  id            Int      @id @default(autoincrement())
  canonicalId   Int
  duplicateId   Int
  snapshot      Json
  performedById Int?
  createdAt     DateTime @default(now())
  performedBy   User?    @relation("BookMergeEventsPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([canonicalId])
  @@index([duplicateId])
  @@index([createdAt])
}

enum AuditOperation {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

/// Append-only trace of every write to the audited models (lib/audit/models.ts),
/// captured automatically by the Prisma client extension in lib/audit/extension.ts —
/// no route calls it by hand. Never updated; only ever deleted in bulk by the
/// retention purge.
///
/// Storage discipline (Supabase free tier, 500 MB hard cap):
///   - `changes` holds a FIELD-LEVEL diff only, `{ field: [avant, après] }`.
///     Never a pair of full row snapshots on an update.
///   - `snapshot` holds the full row and is populated ONLY on DELETE, because
///     that is the only case where the data is gone and a restore needs it.
///   - Secrets (password, tokens…) and long/blob-ish values are dropped or
///     replaced by a size marker before anything is written — see redact.ts.
///   - Rows older than the retention window are purged nightly
///     (/api/cron/purge-audit-events), 14 days normally, 7 when the table
///     grows past AUDIT_TABLE_SOFT_LIMIT_MB.
///
/// actorEmail is denormalized on purpose: the log has to keep naming its author
/// after that user is deleted, so there is deliberately no FK on actorId.
model AuditEvent {
  id         Int            @id @default(autoincrement())
  /// Prisma model name, e.g. "User", "Bill", "Orders", "Assignment".
  model      String
  /// Primary key of the touched row, as text (composite keys join on ":").
  recordId   String
  operation  AuditOperation
  actorId    Int?
  actorEmail String?
  /// `{ field: [avant, après] }`. Empty object on DELETE.
  changes    Json
  /// Full row, DELETE only — what a restore replays.
  snapshot   Json?
  createdAt  DateTime       @default(now())

  @@index([createdAt])
  @@index([model, recordId])
  @@index([actorId])
}

/// Pre-backfill snapshot of Book.audio_filepath.
///
/// The rewrite from the NAS path (`T:\2022\21525  Titre`) to the bucket prefix
/// (`dirt/2022/21525  Titre/`) is one-way — trailing dots stripped for Windows
/// cannot be reconstructed — so the original is kept here. Written once by
/// scripts/backfill-audio-paths.ts; safe to drop when you're confident.
model AudioFilepathBackup {
  bookId    Int      @id
  oldPath   String
  newPath   String
  createdAt DateTime @default(now())
}

/// Health of a book's link to its audio in the bucket.
///   OK             the folder exists and holds audio
///   FOLDER_EMPTY   the folder exists but contains no audio — upload landed empty
///   FOLDER_MISSING nothing at that prefix at all
///   NO_PATH        audio_filepath is null
///   UNVERIFIED     never checked
enum AudioLinkStatus {
  OK
  FOLDER_EMPTY
  FOLDER_MISSING
  NO_PATH
  UNVERIFIED
}

/// Audio folders in the bucket that no book points at.
///
/// Rows describe storage, they don't own it: nothing here moves, renames or
/// deletes an object. `prefix` is the bucket key prefix exactly as stored,
/// trailing slash included, so it can be handed straight to ListObjectsV2.
///
/// Refreshed by scripts/sync-audio-links.ts: folders still orphaned get their
/// lastSeenAt bumped, folders that stopped being orphaned are deleted.
model OrphanAudioFolder {
  id           Int       @id @default(autoincrement())
  prefix       String    @unique
  year         Int?
  /// Leading number in the folder name — matches Book.source_access_id, which is
  /// what lets the relink screen suggest a book instead of making admins search.
  folderNum    Int?
  title        String
  trackCount   Int
  bytes        BigInt
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @updatedAt
  /// Set when an admin relinks the folder to a book.
  linkedBookId Int?
  linkedBook   Book?     @relation(fields: [linkedBookId], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  /// Set when an admin decides the folder is junk (recycle bin, stray upload).
  dismissedAt  DateTime?
  note         String?

  @@index([folderNum])
  @@index([year])
  @@index([dismissedAt])
  @@index([resolvedAt])
}

/// Corbeille for audio tracks an admin removed from a book's folder.
///
/// Deletion is deliberately NOT a bucket delete: the object is copied to the
/// `corbeille/` prefix first and only then removed from its original key, so a
/// mistake stays fixable. The bucket does have versioning, but its lifecycle
/// rule expires noncurrent versions after 30 days and B2 cannot say *which*
/// portal user deleted a track — neither is good enough for recordings that are
/// often the only copy in existence.
///
/// A row is written on delete and updated to record a restore or a purge.
/// Purging is a real, nightly, 14-day sweep (lib/audio/purge.ts) — this used to
/// say no such thing existed. Every row that predates that sweep shipping has
/// `retainForever = true`, set in the migration that added the column, so the
/// "restorable at any time" promise already shown for those specific rows
/// keeps holding; only deletions made after the sweep shipped are ever subject
/// to the 14-day window.
model DeletedAudioTrack {
  id            Int       @id @default(autoincrement())
  /// Nullable + SetNull so the corbeille outlives the book it came from.
  bookId        Int?
  /// Key the object lived at, verbatim — restoring writes it back here.
  originalKey   String
  /// Key it was copied to under `corbeille/`. Unique: two rows must never
  /// claim the same object, or restoring one would delete the other's copy.
  trashKey      String    @unique
  filename      String
  sizeBytes     BigInt
  deletedAt     DateTime  @default(now())
  deletedById   Int?
  restoredAt    DateTime?
  restoredById  Int?
  /// Set by the nightly purge once the bucket object is actually gone.
  purgedAt      DateTime?
  /// Exempts a row from the 14-day purge forever. Backfilled true for every
  /// row that existed when the purge feature shipped; defaults false for
  /// everything soft-deleted afterwards.
  retainForever Boolean   @default(false)
  book          Book?     @relation("BookDeletedAudioTracks", fields: [bookId], references: [id], onDelete: SetNull)
  deletedBy     User?     @relation("AudioTracksDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  restoredBy    User?     @relation("AudioTracksRestoredBy", fields: [restoredById], references: [id], onDelete: SetNull)

  @@index([bookId])
  @@index([deletedAt])
  @@index([restoredAt])
  @@index([purgedAt])
}

enum AudioTrackAction {
  UPLOAD
  RENAME
  DELETE
  RESTORE
}

/// Append-only log of audio track actions (upload/rename/delete/restore), one
/// row per file per action. Unlike DeletedAudioTrack and the other event logs,
/// this one IS an audited model (see lib/audit/config.ts): it exists
/// specifically so these actions — otherwise invisible to the trail, since
/// refreshBookAudioState() writes are wrapped in withoutAudit() — get an
/// automatic AuditEvent through the same Prisma-extension mechanism as
/// everything else. Rows are only ever created, never updated or deleted, so
/// it never produces a DELETE-shaped AuditEvent and never surfaces the
/// generic (bucket-unaware) restore button on /admin/stats.
model AudioTrackEvent {
  id            Int              @id @default(autoincrement())
  /// Nullable + SetNull so the log outlives the book it came from.
  bookId        Int?
  action        AudioTrackAction
  filename      String
  /// Only set for RENAME.
  newFilename   String?
  sizeBytes     BigInt?
  performedById Int?
  createdAt     DateTime         @default(now())
  book          Book?            @relation("BookAudioTrackEvents", fields: [bookId], references: [id], onDelete: SetNull)
  performedBy   User?            @relation("AudioTrackEventsPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([bookId])
  @@index([createdAt])
}

/// Singleton (id = 1) holding the editable content of the public Contact page.
model SiteContact {
  id           Int      @id @default(1)
  orgName      String
  orgSubtitle  String?
  addressLines String
  phones       String
  email        String
  hoursText    String
  metroText    String?
  busText      String?
  visitText    String?
  updatedAt    DateTime @updatedAt
}

enum TeamSection {
  DIRECTION
  CONSEIL
  PERMANENCE
}

/// A member shown on the public Équipe page. Ordered within its section by sortOrder.
model TeamMember {
  id        Int         @id @default(autoincrement())
  name      String
  role      String?
  section   TeamSection
  sortOrder Int         @default(0)
  active    Boolean     @default(true)
  updatedAt DateTime    @updatedAt

  @@index([section, sortOrder])
}

/// A dated milestone on the public Historique timeline (ordered by year).
model HistoryEvent {
  id          Int      @id @default(autoincrement())
  year        Int
  title       String
  description String
  iconKey     String
  updatedAt   DateTime @updatedAt

  @@index([year])
}

/// A FAQ-style card on the public Informations pratiques page (drag-ordered).
model PracticalInfo {
  id         Int      @id @default(autoincrement())
  iconKey    String
  colorTheme String   @default("blue")
  question   String
  body       String // markdown
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@index([sortOrder])
}

/// A membership card on the public Nous rejoindre page (drag-ordered).
model MembershipOption {
  id             Int      @id @default(autoincrement())
  iconKey        String
  colorTheme     String   @default("blue")
  title          String
  body           String // markdown
  highlightLabel String?
  highlightValue String?
  bullets        String? // one bullet per line
  ctaLabel       String?
  ctaHref        String?
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  @@index([sortOrder])
}
